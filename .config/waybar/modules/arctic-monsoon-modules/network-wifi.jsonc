{
  // Wi-Fi module
  "network#wifi": {
      "interface": "wlan0",
      "format-wifi": "{icon}",
      "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
      "format-ethernet": "",
      "format-disconnected": "󰤮 ",
      "format-linked": "",
      "tooltip": true,
      "tooltip-format-wifi": "{essid} - {signalStrength}%",
      "tooltip-format-ethernet": "",
      "tooltip-format-disconnected": "󰤮 ",
      "max-length": 50,
      "interval": 5
  },
}
