#!/bin/sh

source "$HOME/.config/rofi/screenshot-themes/theme.bash"

# Screenshot general options
timestamp=$(date +%Y-%m-%d-%H%M%S)
dir="$(xdg-user-dir PICTURES)/ScreenShots"
filename="$dir/Shot-${timestamp}.png"

# Create dir if not exists
[ -d "$dir" ] || mkdir -p "$dir"

# Rofi options
s_full=""
s_select="󰆞"
s_window=""
s_in3=" 󰔝"
s_select_in3="󰆞 󰔝"
s_window_in3=" 󰔝"
s_all="󰍹"

# Function to get current monitor name based on mouse position (kept for compatibility)
get_current_monitor_name() {
  # Get mouse position
  mouse_x=$(hyprctl cursorpos -j | jq -r '.x')
  mouse_y=$(hyprctl cursorpos -j | jq -r '.y')

  # Find monitor name at cursor position
  hyprctl monitors -j | jq -r --arg mx "$mouse_x" --arg my "$mouse_y" '
        .[] | select(
            (.x | tonumber) <= ($mx | tonumber) and 
            (.x + .width | tonumber) >= ($mx | tonumber) and 
            (.y | tonumber) <= ($my | tonumber) and 
            (.y + .height | tonumber) >= ($my | tonumber)
        ) | .name' | head -n1
}

rofi_cmd() {
  rofi -dmenu \
    -p Screenshot \
    -mesg "Directory :: $dir" \
    -markup-rows \
    -theme "$HOME/.config/rofi/screenshot-themes/$theme.rasi" || pkill rofi
}

run_rofi() {
  printf "%s\n%s\n%s\n%s\n%s\n%s\n" "$s_full" "$s_select" "$s_window" "$s_in3" "$s_select_in3" "$s_window_in3" "$s_all" | rofi_cmd
}

show_notification() {
  if [ -e "$filename" ]; then
    notify-send -r 699 -i "$filename" "Screenshot" "Screenshot saved and copied to clipboard"
  else
    notify-send -r 699 -i "user-trash" "Screenshot" "Screenshot Canceled"
  fi
}

copy_screenshot() {
  wl-copy <"$filename"
}

take_screenshot() {
  mode="$1"

  case "$mode" in
  "full")
    hyprshot -m output -o "$dir" -f "Shot-${timestamp}.png"
    ;;

  "full-delay")
    # Select monitor FIRST
    monitor_geom=$(
      hyprctl monitors -j | jq -r '
        .[] |
        "\(.x),\(.y) \(.width)x\(.height)"
      ' | slurp
    )

    [ -z "$monitor_geom" ] && return 1

    # Countdown AFTER selection
    countdown 3

    grim -g "$monitor_geom" "$filename"
    ;;

  "window")
    # Select window FIRST
    window_geom=$(hyprctl clients -j | jq -r '
      .[] |
      "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"
    ' | slurp)

    [ -z "$window_geom" ] && return 1

    # Countdown AFTER selecting window
    countdown 3

    grim -g "$window_geom" "$filename"
    ;;

  "window-now")
    # Select window FIRST
    window_geom=$(hyprctl clients -j | jq -r '
      .[] |
      "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"
    ' | slurp)

    [ -z "$window_geom" ] && return 1

    grim -g "$window_geom" "$filename"
    ;;

  "select")
    # Select region FIRST
    region=$(slurp)

    [ -z "$region" ] && return 1

    # Countdown AFTER selection
    countdown 3

    grim -g "$region" "$filename"
    ;;

  "select-now")
    region=$(slurp)

    [ -z "$region" ] && return 1

    grim -g "$region" "$filename"
    ;;

  "all")
    # ALL monitors together
    grim "$filename"
    ;;
  esac

  # Check if screenshot was taken successfully
  if [ "$?" -eq 0 ] && [ -e "$filename" ] && [ -s "$filename" ]; then
    paplay /usr/share/sounds/freedesktop/stereo/screen-capture.oga >/dev/null 2>&1
    copy_screenshot
    show_notification
    return 0
  else
    [ -e "$filename" ] && [ ! -s "$filename" ] && rm -f "$filename"
    return 1
  fi
}

countdown() {
  notify-send \
    -r 345 \
    -t 2500 \
    -i ~/.config/hypr/config/assets/screenshot.png \
    "Taking Shot in : ${1} Seconds"

  sleep "$1"
}

run_cmd() {
  case $1 in
  --now)
    take_screenshot "full"
    ;;

  --sel)
    take_screenshot "select-now"
    ;;

  --window)
    take_screenshot "window-now"
    ;;

  --in3)
    take_screenshot "full-delay"
    ;;

  --sel-in3)
    take_screenshot "select"
    ;;

  --window-in3)
    take_screenshot "window"
    ;;

  --all)
    take_screenshot "all"
    ;;
  esac
}

select_option="$(run_rofi)"
case ${select_option} in
"$s_full")
  run_cmd --now
  ;;
"$s_select")
  run_cmd --sel
  ;;
"$s_window")
  run_cmd --window
  ;;
"$s_in3")
  run_cmd --in3
  ;;
"$s_select_in3")
  run_cmd --sel-in3
  ;;
"$s_window_in3")
  run_cmd --window-in3
  ;;
"$s_all")
  run_cmd --all
  ;;
esac
