#!/bin/bash

main_menu() {
  printf "Browsers\nTerminal\nFiles\nPower"
}

browser_menu() {
  printf "Firefox\nChrome\nBrave\nBack"
}

power_menu() {
  printf "Shutdown\nReboot\nLogout\nBack"
}

chosen=$(main_menu | rofi -dmenu -p "Menu")

case "$chosen" in
Browsers)
  browser_choice=$(browser_menu | rofi -dmenu -p "Browsers")

  case "$browser_choice" in
  Firefox)
    firefox
    ;;
  Chrome)
    google-chrome-stable
    ;;
  Brave)
    brave
    ;;
  esac
  ;;

Terminal)
  kitty
  ;;

Files)
  thunar
  ;;

Power)
  power_choice=$(power_menu | rofi -dmenu -p "Power")

  case "$power_choice" in
  Shutdown)
    systemctl poweroff
    ;;
  Reboot)
    systemctl reboot
    ;;
  Logout)
    hyprctl dispatch exit
    ;;
  esac
  ;;
esac
