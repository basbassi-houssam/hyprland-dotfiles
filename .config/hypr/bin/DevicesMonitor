#!/bin/bash

# Monitor for new block devices and send notifications
# Dependencies: lsblk, (notify-send for desktop notifications)

# File to store previous state
STATE_FILE="/tmp/lsblk_monitor_state"

# Check if notify-send is available (for desktop notifications)
if ! command -v notify-send &> /dev/null; then
    echo "Warning: notify-send not found. Install libnotify-bin or similar package."
    USE_NOTIFY=false
else
    USE_NOTIFY=true
fi

# Function to get current devices list with relevant info
get_devices() {
    lsblk -o NAME,SIZE,TYPE,MOUNTPOINT,MODEL -l -n 2>/dev/null | grep -E "disk|part" | awk '{
        name=$1; size=$2; type=$3; mount=$4; model="";
        for(i=5;i<=NF;i++) model=model $i " ";
        gsub(/^[ \t]+|[ \t]+$/, "", model);
        print name "|" size "|" type "|" mount "|" model
    }' | sort
}

# Function to send notification
send_notification() {
    local device_name="$1"
    local device_size="$2"
    local device_type="$3"
    local device_model="$4"
    
    local message="Device: $device_name"
    [ -n "$device_size" ] && message="$message\nSize: $device_size"
    [ -n "$device_model" ] && message="$message\nModel: $device_model"
    
    if [ "$USE_NOTIFY" = true ]; then
        notify-send -u normal -t 5000 "🔌 New Storage Device Detected" "$message"
    else
        echo "[$(date)] New device detected: $device_name ($device_model)"
    fi
}

# Function to find new devices by comparing with saved state
check_new_devices() {
    local current_state="$1"
    local previous_state="$2"
    
    if [ ! -f "$previous_state" ]; then
        echo "$current_state" > "$previous_state"
        return
    fi
    
    # Find devices in current that aren't in previous
    while IFS='|' read -r name size type mount model; do
        if ! grep -q "^${name}|" "$previous_state"; then
            # New device found
            send_notification "$name" "$size" "$type" "$model"
        fi
    done <<< "$current_state"
    
    # Update state file
    echo "$current_state" > "$previous_state"
}

# Main monitoring loop
monitor_devices() {
    local interval="${1:-2}"  # Check every 2 seconds by default
    
    echo "Starting device monitor (checking every ${interval}s)..."
    echo "Press Ctrl+C to stop"
    
    # Initial state
    local initial_state=$(get_devices)
    echo "$initial_state" > "$STATE_FILE"
    
    while true; do
        local current_state=$(get_devices)
        check_new_devices "$current_state" "$STATE_FILE"
        sleep "$interval"
    done
}

# One-time check mode (for testing)
one_time_check() {
    echo "Checking for new devices (one-time)..."
    local current_state=$(get_devices)
    
    if [ ! -f "$STATE_FILE" ]; then
        echo "No previous state found. Saving current state..."
        echo "$current_state" > "$STATE_FILE"
        echo "Run again to detect new devices"
    else
        check_new_devices "$current_state" "$STATE_FILE"
    fi
}

# Show usage
usage() {
    echo "Usage: $0 [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  -m, --monitor [SECONDS]  Monitor continuously (default interval: 2s)"
    echo "  -o, --once               One-time check for new devices"
    echo "  -c, --clear              Clear saved state"
    echo "  -h, --help               Show this help message"
    echo ""
    echo "Examples:"
    echo "  $0 --monitor             # Monitor with 2s interval"
    echo "  $0 --monitor 5           # Monitor with 5s interval"
    echo "  $0 --once                # Check once for new devices"
}

# Parse arguments
case "${1:-}" in
    -m|--monitor)
        interval="${2:-2}"
        monitor_devices "$interval"
        ;;
    -o|--once)
        one_time_check
        ;;
    -c|--clear)
        rm -f "$STATE_FILE"
        echo "State file cleared"
        ;;
    -h|--help|"")
        usage
        ;;
    *)
        echo "Unknown option: $1"
        usage
        exit 1
        ;;
esac
