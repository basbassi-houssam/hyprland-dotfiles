#!/bin/bash

# Dynamic Monitor Configuration for Hyprland
# Detects connected monitors and generates appropriate configs

CONFIG_DIR="$HOME/.config/hypr/configs"
MONITOR_CONFIG="$CONFIG_DIR/monitors.conf"
WAYBAR_LAUNCHER="$HOME/.config/hypr/launchers/WayBar"

# Color output for logging
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() {
  echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
  echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
  echo -e "${RED}[ERROR]${NC} $1"
}

# Count connected monitors
count_monitors() {
  hyprctl monitors -j | jq 'length'
}

# Get monitor resolution and refresh rate properly
get_monitor_info() {
  local monitor_name="$1"
  local monitor_data=$(hyprctl monitors -j | jq -r ".[] | select(.name==\"$monitor_name\")")

  local width=$(echo "$monitor_data" | jq -r '.width')
  local height=$(echo "$monitor_data" | jq -r '.height')
  local refresh_rate=$(echo "$monitor_data" | jq -r '.refreshRate | floor')
  local scale=$(echo "$monitor_data" | jq -r '.scale')

  echo "$width|$height|$refresh_rate|$scale"
}

# Get monitors sorted by priority (DP-1 first, then DP-2, etc)
get_sorted_monitors() {
  # Get all monitors and sort them by name (DP-1 before DP-2)
  hyprctl monitors -j | jq -r '.[].name' | sort -V
}

# Generate workspace distribution based on monitor count (hierarchical)
generate_workspace_distribution() {
  local monitor_count=$(count_monitors)
  local monitors=($(get_sorted_monitors))

  case $monitor_count in
  1)
    # Single monitor: 5 workspaces (1-5)
    echo "${monitors[0]} 1 2 3 4 5"
    ;;
  2)
    # Dual monitors: first monitor gets 1-4, second gets 5-8
    echo "${monitors[0]} 1 2 3 4"
    echo "${monitors[1]} 5 6 7 8"
    ;;
  3)
    # Triple monitors: hierarchical distribution
    echo "${monitors[0]} 1 2 3"
    echo "${monitors[1]} 4 5 6"
    echo "${monitors[2]} 7 8 9"
    ;;
  *)
    # More than 3 monitors: distribute 9 workspaces hierarchically
    local ws_per_monitor=$((9 / monitor_count))
    local remainder=$((9 % monitor_count))
    local ws_start=1

    for ((i = 0; i < $monitor_count; i++)); do
      local ws_count=$ws_per_monitor
      [[ $i -lt $remainder ]] && ws_count=$((ws_count + 1))

      local workspaces=""
      for ((j = 0; j < $ws_count; j++)); do
        workspaces="$workspaces $((ws_start + j))"
      done
      echo "${monitors[$i]}$workspaces"
      ws_start=$((ws_start + ws_count))
    done
    ;;
  esac
}

# Generate Hyprland monitor configuration with proper positioning
generate_hyprland_config() {
  local monitor_count=$(count_monitors)

  log_info "Generating Hyprland config for $monitor_count monitor(s) with refresh rates..."

  # Ensure config directory exists
  mkdir -p "$CONFIG_DIR"

  # Clear existing config
  >"$MONITOR_CONFIG"

  # Get sorted monitors
  local monitors=($(get_sorted_monitors))
  local x_offset=0

  for i in "${!monitors[@]}"; do
    local monitor="${monitors[$i]}"

    # Get monitor info
    local monitor_info=$(get_monitor_info "$monitor")
    IFS='|' read -r width height refresh_rate scale <<<"$monitor_info"

    # Validate we got proper values
    if [[ -z "$width" || -z "$height" || -z "$refresh_rate" ]]; then
      log_error "Failed to get proper info for $monitor"
      local mode="preferred"
    else
      local mode="${width}x${height}@${refresh_rate}"
    fi

    log_info "Monitor $monitor: $mode, scale: $scale, position: ${x_offset}x0"

    # Write monitor line with proper format (no gap between monitors)
    if [[ $i -eq 0 ]]; then
      # First monitor at 0x0
      echo "monitor=$monitor, $mode, 0x0, $scale" >>"$MONITOR_CONFIG"
    else
      # Place next monitor right after the previous one
      echo "monitor=$monitor, $mode, ${x_offset}x0, $scale" >>"$MONITOR_CONFIG"
    fi

    # Update x_offset for next monitor (no gap, just width)
    x_offset=$((x_offset + width))
  done

  # Add workspace bindings with persistent flag
  echo "" >>"$MONITOR_CONFIG"
  echo "# Workspace assignments" >>"$MONITOR_CONFIG"

  # Generate workspace-to-monitor assignments with persistent:true
  while IFS= read -r line; do
    if [[ -n "$line" ]]; then
      local monitor=$(echo "$line" | cut -d' ' -f1)
      local workspaces=$(echo "$line" | cut -d' ' -f2-)
      for ws in $workspaces; do
        echo "workspace=$ws, monitor:$monitor, persistent:true" >>"$MONITOR_CONFIG"
      done
    fi
  done < <(generate_workspace_distribution)

  log_info "Generated Hyprland config: $MONITOR_CONFIG"
  echo ""
  cat "$MONITOR_CONFIG"
}

# Reload Hyprland configuration
reload_hyprland() {
  log_info "Reloading Hyprland configuration..."

  # First, ensure the config is sourced in hyprland.conf
  # Check if the source line already exists
  if ! grep -q "source = $MONITOR_CONFIG" "$HOME/.config/hypr/hyprland.conf"; then
    log_warn "Source line not found in hyprland.conf, adding it..."
    echo "" >>"$HOME/.config/hypr/hyprland.conf"
    echo "# Dynamic monitor config" >>"$HOME/.config/hypr/hyprland.conf"
    echo "source = $MONITOR_CONFIG" >>"$HOME/.config/hypr/hyprland.conf"
  fi

  # Perform full hyprctl reload
  log_info "Running hyprctl reload..."
  hyprctl reload

  # Small delay to let reload settle
  sleep 1

  log_info "Hyprland configuration reloaded"
}

# Restart Waybar using the launcher script
restart_waybar() {
  if [[ -f "$WAYBAR_LAUNCHER" ]]; then
    log_info "Restarting Waybar using launcher: $WAYBAR_LAUNCHER"
    "$WAYBAR_LAUNCHER"
  else
    log_warn "Waybar launcher not found at $WAYBAR_LAUNCHER, using fallback"
    killall waybar 2>/dev/null
    sleep 0.5
    waybar &
  fi
  log_info "Waybar restarted"
}

# Main execution
main() {
  log_info "=== Dynamic Monitor Configuration ==="

  # Detect current monitor setup
  local monitor_count=$(count_monitors)
  log_info "Detected $monitor_count monitor(s):"
  hyprctl monitors -j | jq -r '.[] | "  - \(.name): \(.width)x\(.height) @ \(.refreshRate)Hz (scale: \(.scale))"'

  # Show monitor hierarchy
  log_info "Monitor hierarchy (primary to secondary):"
  local monitors=($(get_sorted_monitors))
  for i in "${!monitors[@]}"; do
    echo "  - ${monitors[$i]} (position priority: $((i + 1)))"
  done

  # Generate workspace distribution plan
  log_info "Workspace distribution plan:"
  while IFS= read -r line; do
    if [[ -n "$line" ]]; then
      local monitor=$(echo "$line" | cut -d' ' -f1)
      local workspaces=$(echo "$line" | cut -d' ' -f2-)
      log_info "  $monitor: workspaces $workspaces"
    fi
  done < <(generate_workspace_distribution)

  # Generate Hyprland configuration
  generate_hyprland_config

  # Apply changes
  reload_hyprland
  restart_waybar

  echo ""
  log_info "✅ Configuration complete!"
  log_info "   Monitor layout applied with persistent workspaces"

  # Show final workspace distribution
  log_info "Final workspace distribution:"
  while IFS= read -r line; do
    if [[ -n "$line" ]]; then
      local monitor=$(echo "$line" | cut -d' ' -f1)
      local workspaces=$(echo "$line" | cut -d' ' -f2-)
      echo "  - $monitor: workspaces $workspaces (persistent)"
    fi
  done < <(generate_workspace_distribution)

  # Verify reload worked
  log_info "Verifying Hyprland reload..."
  sleep 1
  hyprctl monitors
}

# Run the script
main
